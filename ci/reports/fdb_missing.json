{
 "build": "1.60.1.70959",
 "descriptions": {
  "druid": {
   "increases damage done by your swipe ability by #% and reduces the chance enemies have to detect you while prowling as if you were # level higher": [
    "Feral Instinct",
    "Increases damage done by your Swipe ability by 10% and reduces the chance enemies have to detect you while Prowling as if you were 1 level higher.",
    1
   ],
   "instantly convert ? mana into ? energy. shifting power's cost is reduced by effects that reduce the cost of shapeshifting": [
    "Shifting Power",
    "Instantly convert ? Mana into ? Energy. Shifting Power's cost is reduced by effects that reduce the cost of Shapeshifting.",
    1
   ]
  },
  "hunter": {
   "command a hawk to dive-bomb your targeted enemy, dealing # (+#% of ranged attack power) physical damage and continuing its assault for # sec. only # hawks can be active at once. summon hawk shares its cooldown with arcane shot": [
    "Summon Hawk",
    "Command a hawk to dive-bomb your targeted enemy, dealing 32 (+5% of ranged attack power) Physical damage and continuing its assault for 18 sec. Only 2 hawks can be active at once. Summon Hawk shares its cooldown with Arcane Shot.",
    1
   ]
  },
  "mage": {
   "gives your chill effects a #% chance to grant you the fingers of frost effect, which treats your next # spell cast as if the target were frozen. lasts # sec": [
    "Fingers of Frost",
    "Gives your Chill effects a 15% chance to grant you the Fingers of Frost effect, which treats your next 1 spell cast as if the target were Frozen. Lasts 15 sec.",
    1
   ],
   "shield yourself, absorbing # (+#% of frost spell power) damage and increasing your frost damage by #% for # min. while shielded, your frost damage is increased by an additional #% and you do not lose casting time when you take damage": [
    "Ice Barrier",
    "Shield yourself, absorbing 431 (+10% of Frost spell power) damage and increasing your Frost damage by 15% for 1 min. While shielded, your Frost damage is increased by an additional 5% and you do not lose casting time when you take damage.",
    1
   ]
  },
  "paladin": {
   "gives your damaging melee attacks a chance to reduce the target's attack power by # for # sec. (numbers at level #; they grow with your level.)": [
    "Vindication",
    "Gives your damaging melee attacks a chance to reduce the target's Attack Power by 67 for 30 sec. (Numbers at level 60; they grow with your level.)",
    1
   ],
   "reduces the cast time of your turn undead spell by # sec, its cooldown by # sec, and allows it to affect demons": [
    "Turn Evil",
    "Reduces the cast time of your Turn Undead spell by 0.5 sec, its cooldown by 5 sec, and allows it to affect Demons.",
    1
   ],
   "swear an oath to protect target ally for # min, increasing the healing of your holy light on them by up to #, your flash of light by up to #, and your holy shock by up to #. only one oath of light may be sworn by the paladin at any one time. (numbers at level #; they grow with your level.)": [
    "Oath of Light",
    "Swear an Oath to protect target ally for 5 min, increasing the healing of your Holy Light on them by up to 400, your Flash of Light by up to 115, and your Holy Shock by up to 230. Only one Oath of Light may be sworn by the Paladin at any one time. (Numbers at level 60; they grow with your level.)",
    1
   ]
  },
  "priest": {
   "afflicts your target with shadow energy that causes all party members to be healed for #% of any shadow spell damage you deal for # sec. you receive #% increased healing on yourself from this effect": [
    "Vampiric Embrace",
    "Afflicts your target with Shadow energy that causes all party members to be healed for 10% of any Shadow spell damage you deal for 30 sec. You receive 100% increased healing on yourself from this effect.",
    1
   ],
   "places a spell on the target that heals them for # (scales with bonus healing) the next time they take damage or receive non-periodic healing. when the heal occurs, prayer of mending jumps to a party or raid member within # yards. jumps up to # times and lasts # sec after each jump. this spell can only be placed on one target at a time per caster": [
    "Prayer of Mending",
    "Places a spell on the target that heals them for 172 (scales with bonus healing) the next time they take damage or receive non-periodic healing. When the heal occurs, Prayer of Mending jumps to a party or raid member within 20 yards. Jumps up to 5 times and lasts 30 sec after each jump. This spell can only be placed on one target at a time per caster.",
    1
   ],
   "your non-periodic critical heals create a protective shield on the target, absorbing #% of the amount healed. shields up to # damage and lasts # sec. (numbers at level #; they grow with your level.)": [
    "Divine Aegis",
    "Your non-periodic critical heals create a protective shield on the target, absorbing 5% of the amount healed. Shields up to 1200 damage and lasts 12 sec. (Numbers at level 60; they grow with your level.)",
    1
   ]
  },
  "rogue": {
   "finishing move that marks the target, storing a portion of the damage dealt by your attacks per combo point. garrote and rupture damage is stored at twice the rate. after # sec, the stored damage is dealt, up to a maximum increased by attack power and critical strike chance: # point : #% stored, # (scales with attack power and critical strike chance) damage cap # points: #% stored, # (scales with attack power and critical strike chance) damage cap # points: #% stored, # (scales with attack power and critical strike chance) damage cap # points: #% stored, # (scales with attack power and critical strike chance) damage cap # points: #% stored, # (scales with attack power and critical strike chance) damage cap": [
    "Death Mark",
    "Finishing move that marks the target, storing a portion of the damage dealt by your attacks per Combo Point. Garrote and Rupture damage is stored at twice the rate. After 6 sec, the stored damage is dealt, up to a maximum increased by Attack Power and Critical Strike chance: 1 point : 12% stored, 165 (scales with attack power and critical strike chance) damage cap 2 points: 24% stored, 267 (scales with attack power and critical strike chance) damage cap 3 points: 36% stored, 369 (scales with attack power and critical strike chance) damage cap 4 points: 48% stored, 471 (scales with attack power and critical strike chance) damage cap 5 points: 60% stored, 573 (scales with attack power and critical strike chance) damage cap",
    1
   ],
   "gives you a #% chance to add a combo point to your target after dodging their attack or fully resisting one of their spells": [
    "Setup",
    "Gives you a 15% chance to add a Combo Point to your target after Dodging their attack or fully resisting one of their spells.",
    1
   ],
   "gives your melee weapon attacks a benefit depending on the weapon. axe/sword: your successful melee attacks have a #% chance to trigger an extra attack on the target. dagger/fist: increases your critical strike chance by #%. mace: your attacks ignore #% of your target's armor": [
    "Hack and Slash",
    "Gives your melee weapon attacks a benefit depending on the weapon. Axe/Sword: Your successful melee attacks have a 1% chance to trigger an extra attack on the target. Dagger/Fist: Increases your critical strike chance by 1%. Mace: Your attacks ignore 3% of your target's armor.",
    1
   ],
   "increases the energy cost reduction of your poised ability by #": [
    "Composure",
    "Increases the Energy cost reduction of your Poised ability by 5.",
    1
   ],
   "increases the energy generated by your shank ability by # and reduces its cooldown by # sec": [
    "Flash of Steel",
    "Increases the Energy generated by your Shank ability by 3 and reduces its cooldown by 0.4 sec.",
    1
   ],
   "increases your stealth detection as if you were # level higher and reduces your chance to be hit by spells and ranged attacks by #%": [
    "Heightened Senses",
    "Increases your Stealth detection as if you were 1 level higher and reduces your chance to be hit by spells and ranged attacks by 2%.",
    1
   ],
   "reduces the chance enemies have to detect you while in stealth mode as if you were # level higher": [
    "Master of Deception",
    "Reduces the chance enemies have to detect you while in Stealth mode as if you were 1 level higher.",
    1
   ],
   "reduces the energy cost of your expose armor ability by #, and refunds # combo point when cast with # combo points": [
    "Improved Expose Armor",
    "Reduces the Energy cost of your Expose Armor ability by 5, and refunds 1 Combo Point when cast with 5 Combo Points.",
    1
   ]
  },
  "shaman": {
   "when you deal damage with a melee attack, you have a ?% chance (based on weapon speed) to reduce the cast time and mana cost of your next lightning bolt spell by #%. stacks up to # times. lasts # sec": [
    "Maelstrom Weapon",
    "When you deal damage with a melee attack, you have a ?% chance (based on weapon speed) to reduce the cast time and Mana cost of your next Lightning Bolt spell by 20%. Stacks up to 5 times. Lasts 30 sec.",
