{"id": "0602-report-reply", "kind": "script", "why": "owner 28 Nov: a reply section on the report page for the CurseForge install report", "args": {"module": "remote_pr", "args": {"repo": "pvwvuow/wow", "branch": "feat/report-reply", "title": "report page: reply to the CurseForge install report", "body": "Adds a section 'reply to you' (a polite support reply) to report.html: Forever is the focus, Retail was only a test. Draft only. Publish with tools/publish_site.py after merging.", "replace": [{"path": "report.html", "old": "<div class=\"ad-note reveal\">", "new": "<style>\n.rp-reply{margin-top:1.4rem}\n.rp-reply h3{margin:0 0 .3rem;font-size:1.15rem;color:#f5d97a}\n.rp-reply .rp-meta{margin:0 0 1rem;font-size:.85rem;opacity:.7}\n.rp-reply p{line-height:1.9;margin:.5rem 0}\n.rp-reply ol{margin:.5rem 0;padding-inline-start:1.4rem;line-height:1.9}\n.rp-reply li{margin:.3rem 0}\n</style>\n<div class=\"ad-card reveal rp-reply\" id=\"reply\">\n      <h3>\u067e\u0627\u0633\u062e \u0628\u0647 \u0634\u0645\u0627</h3>\n      <p class=\"rp-meta\">\u062f\u0631 \u067e\u0627\u0633\u062e \u0628\u0647 \u06af\u0632\u0627\u0631\u0634 \u00ab\u0631\u0648\u0634\u0646\u200c\u0646\u0634\u062f\u0646 \u0627\u0641\u0632\u0648\u0646\u0647 \u0631\u0648\u06cc Forever \u0648 \u0628\u0633\u062a\u0647\u200c\u0634\u062f\u0646 \u0622\u0646 \u0631\u0648\u06cc Retail\u00bb</p>\n      <p>\u0633\u0644\u0627\u0645 \u0648 \u0648\u0642\u062a \u0628\u062e\u06cc\u0631\u060c</p>\n      <p>\u0627\u0632 \u0627\u06cc\u0646\u06a9\u0647 \u0627\u0641\u0632\u0648\u0646\u0647 \u0631\u0627 \u0646\u0635\u0628 \u06a9\u0631\u062f\u06cc\u062f \u0648 \u0628\u0631\u0627\u06cc \u0645\u0627 \u06af\u0632\u0627\u0631\u0634 \u0641\u0631\u0633\u062a\u0627\u062f\u06cc\u062f\u060c \u0635\u0645\u06cc\u0645\u0627\u0646\u0647 \u0633\u067e\u0627\u0633\u06af\u0632\u0627\u0631\u06cc\u0645. \u0645\u062a\u0623\u0633\u0641\u06cc\u0645 \u06a9\u0647 \u0628\u0627 \u0645\u0634\u06a9\u0644 \u0631\u0648\u0628\u0647\u200c\u0631\u0648 \u0634\u062f\u06cc\u062f \u0648 \u0628\u0627\u0628\u062a \u062f\u06cc\u0631\u06a9\u0631\u062f \u062f\u0631 \u067e\u0627\u0633\u062e\u200c\u06af\u0648\u06cc\u06cc \u0627\u0632 \u0634\u0645\u0627 \u067e\u0648\u0632\u0634 \u0645\u06cc\u200c\u062e\u0648\u0627\u0647\u06cc\u0645.</p>\n      <p>\u0641\u0639\u0644\u0627\u064b \u062a\u0645\u0627\u0645 \u062a\u0645\u0631\u06a9\u0632 \u0645\u0627 \u0631\u0648\u06cc \u0646\u0633\u062e\u0647\u0654 <b>Forever</b> \u0627\u0633\u062a. \u0646\u0633\u062e\u0647\u0654 Retail \u0641\u0642\u0637 \u06cc\u06a9 \u0646\u0633\u062e\u0647\u0654 \u0622\u0632\u0645\u0627\u06cc\u0634\u06cc \u0628\u0648\u062f \u0648 \u062f\u0631 \u062d\u0627\u0644 \u062d\u0627\u0636\u0631 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0628\u0647 \u0647\u0645\u06cc\u0646 \u062f\u0644\u06cc\u0644 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u067e\u0646\u062c\u0631\u0647\u200c\u0627\u0634 \u0628\u0633\u062a\u0647 \u0634\u0648\u062f \u06cc\u0627 \u0628\u0647\u200c\u062c\u0627\u06cc \u0645\u062a\u0646 \u0641\u0627\u0631\u0633\u06cc\u060c \u0645\u0631\u0628\u0639 \u0646\u0634\u0627\u0646 \u062f\u0647\u062f. \u0644\u0637\u0641\u0627\u064b \u0641\u0639\u0644\u0627\u064b \u0622\u0646 \u0631\u0627 \u06a9\u0646\u0627\u0631 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f.</p>\n      <p>\u0628\u0631\u0627\u06cc \u0627\u06cc\u0646\u06a9\u0647 \u0631\u0648\u06cc Forever \u062f\u0631\u0633\u062a \u06a9\u0627\u0631 \u06a9\u0646\u062f\u060c \u0627\u06cc\u0646 \u0645\u0648\u0627\u0631\u062f \u0631\u0627 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f:</p>\n      <ol>\n        <li>\u062c\u062f\u06cc\u062f\u062a\u0631\u06cc\u0646 \u0646\u0633\u062e\u0647\u0654 \u00abWoWFA Forever\u00bb \u0631\u0627 \u0627\u0632 CurseForge \u0646\u0635\u0628 \u06a9\u0646\u06cc\u062f\u060c \u0646\u0647 \u0646\u0633\u062e\u0647\u0654 Retail.</li>\n        <li>\u067e\u0648\u0634\u0647\u0654 <span dir=\"ltr\">WoWFA</span> \u0628\u0627\u06cc\u062f \u062f\u0627\u062e\u0644 \u067e\u0648\u0634\u0647\u0654 <span dir=\"ltr\">Interface/AddOns</span> \u0647\u0645\u0627\u0646 \u0628\u0627\u0632\u06cc\u0650 Forever \u0628\u0627\u0634\u062f.</li>\n        <li>\u0627\u06af\u0631 \u062f\u0631 \u0641\u0647\u0631\u0633\u062a \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627 \u0647\u0646\u0648\u0632 \u0642\u0631\u0645\u0632 \u0628\u0648\u062f\u060c \u06af\u0632\u06cc\u0646\u0647\u0654 <span dir=\"ltr\">Load out of date AddOns</span> \u0631\u0627 \u0628\u0627\u0644\u0627\u06cc \u0641\u0647\u0631\u0633\u062a \u0631\u0648\u0634\u0646 \u06a9\u0646\u06cc\u062f \u0648 \u0628\u0627\u0632\u06cc \u0631\u0627 \u06cc\u06a9 \u0628\u0627\u0631 \u0628\u0628\u0646\u062f\u06cc\u062f \u0648 \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0627\u0632 \u06a9\u0646\u06cc\u062f.</li>\n      </ol>\n      <p>\u0627\u06af\u0631 \u0628\u0627\u0632 \u0647\u0645 \u0631\u0648\u0634\u0646 \u0646\u0634\u062f\u060c \u0644\u0637\u0641\u0627\u064b \u0627\u0632 \u0647\u0645\u06cc\u0646 \u0635\u0641\u062d\u0647 \u06cc\u06a9 \u06af\u0632\u0627\u0631\u0634 \u062f\u06cc\u06af\u0631 \u0628\u0641\u0631\u0633\u062a\u06cc\u062f \u0648 \u0634\u0645\u0627\u0631\u0647\u0654 \u0646\u0633\u062e\u0647\u0654 \u0628\u0627\u0632\u06cc \u0631\u0627 \u0628\u0646\u0648\u06cc\u0633\u06cc\u062f \u0648 \u06cc\u06a9 \u0639\u06a9\u0633 \u0627\u0632 \u0641\u0647\u0631\u0633\u062a \u0627\u0641\u0632\u0648\u0646\u0647\u200c\u0647\u0627 \u0628\u06af\u0630\u0627\u0631\u06cc\u062f \u062a\u0627 \u0633\u0631\u06cc\u0639 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u0645.</p>\n      <p>\u0628\u0627 \u0627\u062d\u062a\u0631\u0627\u0645 \u0648 \u0633\u067e\u0627\u0633<br>\u062a\u06cc\u0645 wowfarsi</p>\n    </div>\n\n    <div class=\"ad-note reveal\">", "count": 1}]}}}
